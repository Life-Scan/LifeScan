# Conexão com o MySQL (driver PyMySQL)
DATABASE_URL=mysql+pymysql://lifescan:SUA_SENHA@localhost:3306/lifescan?charset=utf8mb4

# JWT (HS256). Gere um segredo longo, por exemplo:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-este-segredo
JWT_EXPIRE_MINUTES=480

# Custo do hash bcrypt (opcional, padrão 12)
# BCRYPT_ROUNDS=12

# Origens permitidas no CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Pasta onde os arquivos enviados são gravados (relativa à pasta backend)
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=30

# Solicitações que vencem em até N dias aparecem como "próximas do prazo"
DUE_SOON_DAYS=3

# Distância mínima, em horas, entre duas consultas agendadas
APPOINTMENT_MIN_GAP_HOURS=2

# Email
# Opções de EMAIL_MODE:
#   console : o email aparece no terminal da API (padrão em desenvolvimento/testes)
#   brevo   : envio real via API transacional do Brevo
EMAIL_MODE=console
EMAIL_FROM=LifeScan <nao-responda@lifescan.local>
# Endereço do frontend, usado nos links dos emails
FRONTEND_URL=http://localhost:5173

# Configurações da API Brevo (usadas quando EMAIL_MODE=brevo)
BREVO_API_KEY=sua-chave-api-brevo
# Timeout das requisições em segundos
BREVO_TIMEOUT=15

# Validade da senha provisória de uma conta nova (dias) e do "esqueci minha senha" (minutos)
ACCESS_PASSWORD_DAYS=7
RESET_PASSWORD_MINUTES=60

# Componente de IA: arquivo com os limiares calibrados por ai-model/scripts/calibrar.py
# (relativo à raiz do repositório). Não precisa definir se estiver no padrão.
AI_LIMIARES_PATH=ai-model/models/limiares.json
