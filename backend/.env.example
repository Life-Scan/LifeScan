# Conexão com o MySQL (driver PyMySQL)
DATABASE_URL=mysql+pymysql://lifescan:SUA_SENHA@localhost:3306/lifescan?charset=utf8mb4

# JWT (HS256). Gere um segredo longo, por exemplo:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-este-segredo
JWT_EXPIRE_MINUTES=480

# Custo do hash bcrypt (opcional, padrão 12)
# BCRYPT_ROUNDS=12

# Origens permitidas no CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Pasta onde os arquivos enviados são gravados (relativa à pasta backend)
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=30

# Solicitações que vencem em até N dias aparecem como "próximas do prazo"
DUE_SOON_DAYS=3

# Email
# Opções de EMAIL_MODE:
#   console : o email aparece no terminal da API (padrão em desenvolvimento/testes)
#   smtp    : envio real via servidor SMTP (Gmail, Outlook, Mailtrap, etc.)
EMAIL_MODE=console
EMAIL_FROM=LifeScan <nao-responda@lifescan.local>
# Endereço do frontend, usado nos emails
FRONTEND_URL=http://localhost:5173

# Configurações do servidor SMTP (usadas quando EMAIL_MODE=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-de-app
# STARTTLS: padrão true para portas 587 ou 25
SMTP_TLS=true
# SSL Direto: padrão false (use true para porta 465)
SMTP_SSL=false
# Timeout da conexão em segundos
SMTP_TIMEOUT=15

# Validade da senha provisória de uma conta nova (dias) e do "esqueci minha senha" (minutos)
ACCESS_PASSWORD_DAYS=7
RESET_PASSWORD_MINUTES=60
